# Focus CaseX environment — copy to .env / .env.local and fill in.
# NEVER commit the filled-in file with real secrets (this repo is PUBLIC).

# ---------------------------------------------------------------------------
# DATABASE (Prisma)
# ---------------------------------------------------------------------------
# Local dev (default, zero-setup SQLite — file lives in ./db):
DATABASE_URL=file:./db/custom.db

# Production / Supabase — direct Postgres connection (Prisma, server-side only).
# Get it from: Supabase Dashboard → Project Settings → Database → Connection string.
# Use the SESSION POOLER string (port 5432, host aws-0-<region>.pooler.supabase.com).
# DATABASE_URL="postgresql://postgres.qdnzpdgytxmtmrerkpew:<YOUR-DB-PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# SUPABASE (client-safe values — OK to expose in a public repo)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://qdnzpdgytxmtmrerkpew.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_qh2M3iVtI_4FQOHMoXiuOQ_oTceX6-d
# NOTE: this publishable key is SAFE to expose — supabase/schema.sql enables RLS
# on every table with no policies, so it grants zero data access. All data flow
# goes through the Next.js API routes (auth + role checks) via DATABASE_URL.
